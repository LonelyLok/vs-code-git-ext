{
  "name": "vs-code-git-ext",
  "displayName": "vs-code-git-ext",
  "description": "VS Code Extension for custom git commands",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-code-git-ext.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "myExt.changeCommitTime",
        "title": "Change commit time to now"
      },
      {
        "command": "myExt.deleteBranchLocal",
        "title": "Delete branch locally"
      },
      {
        "command": "myExt.makeNewBranchFromCurrent",
        "title": "Make a new branch from current branch"
      },
      {
        "command": "myExt.fetchAndResetHardOrigin",
        "title": "Fetch and reset hard to origin"
      },
      {
        "command": "myExt.renameBranch",
        "title": "Rename branch name"
      },
      {
        "command": "myExt.refreshView",
        "title": "Refresh view",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myExt",
          "title": "My Ext",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "myExt": [
        {
          "id": "myExtView",
          "name": "My Extension View",
          "icon": "icon.svg"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "myExt.changeCommitTime",
          "when": "viewItem == commitItem",
          "group": "navigation"
        },
        {
          "command": "myExt.deleteBranchLocal",
          "when": "viewItem == nonCurrentBranchItem",
          "group": "navigation"
        },
        {
          "command": "myExt.makeNewBranchFromCurrent",
          "when": "viewItem == currentBranchItem",
          "group": "navigation"
        },
        {
          "command": "myExt.renameBranch",
          "when": "viewItem == currentBranchItem",
          "group": "navigation"
        },
        {
          "command": "myExt.fetchAndResetHardOrigin",
          "when": "viewItem == currentBranchItem",
          "group": "navigation"
        },
        {
          "command": "myExt.refreshView",
          "when": "viewItem == repoStatus",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "ts-loader": "^9.5.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}